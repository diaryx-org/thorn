/target
/.claude/
.DS_Store
.env

# SwiftPM/Xcode build dirs for the Swift package, whose manifest lives at the
# repo root. The UniFFI binding under packages/thorn-swift/uniffi-generated/
# is COMMITTED (a version-resolved clone runs no generators) — regenerate it
# with scripts/gen-bindings.sh; CI diffs it against crates/thorn-svg-ffi.
/.build/
/.swiftpm/
packages/thorn-swift/.build/
packages/thorn-swift/build/

# The Mac host is its own package (apps/thorn-mac/Package.swift), with
# its own build dir; `Packages/` is where `swift package edit` puts a
# dependency being worked on locally, and is never committed.
apps/thorn-mac/.build/
apps/thorn-mac/Packages/
apps/thorn-mac/Package.resolved
