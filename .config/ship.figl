# What ship needs to know about thorn: its release, and its CI. Everything not
# stated here is ship's default — the manifest, the changelog path, the cliff
# config, and that this is a Cargo workspace.
name = thorn
url = https://github.com/diaryx-org/thorn
release_branch = main

# No `verify`: before cutting, a release runs the jobs below.

# The app's marketing version follows the workspace version, and no manifest
# parser in ship reaches an Xcode setting — so the bump runs the task that
# writes it, and the file is staged with the release commit. The `versions`
# job checks they agree.
post_bump = cargo xtask sync-versions
extra_version_files = [apps/thorn-editor/project.yml]

# Not on crates.io: thorn is consumed from git, by commit, so a tag is a name
# for a commit.
publishes = false

# CI. `ship ci` runs these here, in this order, with the same shell, and stops
# at the first that fails; `.github/workflows/ci.yml` runs the same `ship ci` as
# its one Linux check, `CI / cargo xtask ci` (a required status check, so its
# name outlived the command). The Swift package tests are not here: they need a
# Mac, and are that workflow's other job.
#
# A job is `id` (what `ship ci <id>` takes), `name` (the heading a full run
# prints) and `run` (run by `bash -eo pipefail -c` at the repository root).
# Cheapest and most likely to fail first.
job
> *
> > id = fmt
> > name = Format
> > run = cargo fmt --all --check
> *
> > # The app's marketing version is the workspace version.
> > id = versions
> > name = Versions
> > run = cargo xtask sync-versions --check
> *
> > # Warnings are errors here because they are errors in review.
> > id = clippy
> > name = Clippy
> > run = cargo clippy --workspace --all-targets -- -D warnings
> *
> > id = test
> > name = Test
> > run = cargo test --workspace
> *
> > # Workspace feature unification means `cargo check --workspace` can pass
> > # when a crate cannot compile on its own, so each crate is checked the way a
> > # host builds it. The list, and the test that every workspace member is on
> > # it, are in the xtask.
> > id = package-isolation
> > name = Package isolation
> > run = cargo xtask package-isolation
> *
> > # The committed UniFFI binding is what crates/thorn-svg-ffi produces. It is
> > # arch-neutral source, so the drift check needs no Mac.
> > id = bindings
> > name = Swift bindings
> > run = bash scripts/gen-bindings.sh --check
